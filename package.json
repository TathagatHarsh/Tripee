{
  "name": "makemycake",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "role": "tsx scripts/role.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test e2e/shop.spec.ts e2e/checkout.spec.ts e2e/happy-path.spec.ts e2e/auth.spec.ts",
    "docket": "tsx scripts/docket.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "shoot": "tsx scripts/shoot-lab.ts",
    "shot": "tsx scripts/shoot.ts",
    "budget": "tsx scripts/budget.ts",
    "demo": "tsx scripts/demo.ts",
    "postinstall": "prisma generate && node -e \"require('fs').copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs', 'public/maplibre-gl-worker.mjs')\"",
    "shot:message": "tsx scripts/shoot-message.ts",
    "visual": "playwright test --grep 'render baselines'",
    "visual:update": "playwright test --grep 'render baselines' --update-snapshots",
    "a11y": "playwright test e2e/a11y.spec.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "shoot:presets": "tsx scripts/shoot-presets.ts",
    "demo:assignments": "tsx scripts/seedAssignments.ts",
    "assignments:worker": "tsx scripts/assignmentWorker.ts",
    "payments:worker": "tsx scripts/paymentWorker.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@vercel/blob": "^2.8.2",
    "gsap": "^3.15.0",
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5",
    "three": "^0.185.1",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true
  },
  "overrides": {
    "zod": "$zod",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "prisma": {
      "mysql2": "^3.24.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
