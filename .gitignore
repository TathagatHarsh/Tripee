# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# ignore 3d reference
_3d_cake_reference/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
/test-results/
/playwright-report/

# scroll-film working sources (heavy mp4s, masters)
/film-assets/

# Flow source clips and their QC frames (heavy, regenerable)
/gsap-v/

# iCloud conflict copies ("frame_0346 2.webp", "manifest 3.json"). A sync can
# leave three thousand of these in public/film, which is 87MB of nothing.
* [0-9].*
* [0-9][0-9].*

# Cake photo sources. These are shot once and converted into
# public/presets/*.webp, which is what the site actually serves.
/pics/
