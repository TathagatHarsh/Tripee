# Supabase — project "makemycake", region ap-south-1.
#
# Session pooler on port 5432, deliberately:
#   - the transaction pooler (6543) cannot run the DDL `prisma db push` needs;
#   - the direct host is IPv6-only.
# This one URL serves both migration and runtime, which is what prisma.config.ts
# and lib/db.ts both expect.
#
# Local only. .gitignore and .vercelignore both exclude .env*.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=no-verify"

# Kitchen board (/kitchen). HTTP Basic, checked in proxy.ts.
# Unset means the route returns 503 rather than opening.
KITCHEN_USER="kitchen"
KITCHEN_PASSWORD="your_password_here"
